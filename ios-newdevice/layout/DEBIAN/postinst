#!/bin/bash
# Safe postinst: never abort mid-way; never touch system ElleKit; Respring-friendly only.
set +e

JB_PREFIX=""
if [ -d /var/jb ]; then
  JB_PREFIX="/var/jb"
fi

PLIST="${JB_PREFIX}/Library/LaunchDaemons/com.local.newdevice.daemon.plist"
BIN="${JB_PREFIX}/usr/local/bin/newdeviced"
APP="${JB_PREFIX}/Applications/NewDevice.app"

# Permissions only — do not replace any system packages
if [ -f "$PLIST" ]; then
  chown root:wheel "$PLIST" 2>/dev/null || true
  chmod 644 "$PLIST" 2>/dev/null || true
fi
if [ -x "$BIN" ]; then
  chmod 755 "$BIN" 2>/dev/null || true
fi
if [ -d "$APP" ]; then
  chown -R root:wheel "$APP" 2>/dev/null || true
  chmod 755 "$APP/NewDevice" 2>/dev/null || true
fi

mkdir -p "${JB_PREFIX}/var/mobile/NewDevice/Records" 2>/dev/null || true
mkdir -p "${JB_PREFIX}/var/mobile/Library/Preferences/com.local.newdevice" 2>/dev/null || true
# World-readable runtime snapshot dir for sandboxed target apps (tweak injection)
mkdir -p "${JB_PREFIX}/Library/NewDevice" 2>/dev/null || true
chmod 755 "${JB_PREFIX}/Library/NewDevice" 2>/dev/null || true
# Prefer traversable Library for injected processes reading runtime.plist
chmod 755 "${JB_PREFIX}/Library" 2>/dev/null || true
chown -R mobile:mobile "${JB_PREFIX}/var/mobile/NewDevice" 2>/dev/null || true
chown -R mobile:mobile "${JB_PREFIX}/var/mobile/Library/Preferences/com.local.newdevice" 2>/dev/null || true
chown -R mobile:mobile "${JB_PREFIX}/Library/NewDevice" 2>/dev/null || true
# If a previous runtime.plist exists, keep it world-readable
if [ -f "${JB_PREFIX}/Library/NewDevice/runtime.plist" ]; then
  chmod 644 "${JB_PREFIX}/Library/NewDevice/runtime.plist" 2>/dev/null || true
fi

# Load daemon gently (failure must not break install)
if [ -f "$PLIST" ] && command -v launchctl >/dev/null 2>&1; then
  launchctl bootout system "$PLIST" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null || true
  launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load "$PLIST" 2>/dev/null || true
fi

# Only refresh our app icon — NEVER uicache -a (can destabilize SpringBoard)
if [ -d "$APP" ] && command -v uicache >/dev/null 2>&1; then
  uicache -p "$APP" 2>/dev/null || uicache --path "$APP" 2>/dev/null || true
fi

exit 0
