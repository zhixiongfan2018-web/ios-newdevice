<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.newdevice.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/local/bin/newdeviced</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Run as root so syncInjectFilter can rewrite amg.plist / NewDevice.plist under /var/jb -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin</string>
		<key>DYLD_LIBRARY_PATH</key>
		<string>/var/jb/usr/lib</string>
	</dict>
</dict>
</plist>
